<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <privapp-permissions package="com.aicall.agent">
        <!-- Allows capturing the audio stream of phone calls via AudioRecord on VOICE_CALL / VOICE_DOWNLINK -->
        <permission name="android.permission.CAPTURE_AUDIO_OUTPUT" />
        <!-- Allows telephony service to bind to AICallAgent's InCallService without relying solely on default dialer -->
        <permission name="android.permission.CONTROL_INCALL_EXPERIENCE" />
        <!-- Allows answering and ending phone calls programmatically -->
        <permission name="android.permission.MODIFY_PHONE_STATE" />
    </privapp-permissions>
</permissions>
